---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutPageNav from '../components/about/AboutPageNav.astro';
import AboutSkills from '../components/about/AboutSkills.astro';
import AboutTimeline from '../components/about/AboutTimeline.astro';
import AboutHobbies from '../components/about/AboutHobbies.astro';
import { loadResumeProfile } from '../lib/resume-profile';
import { loadSpotifyTopTracks } from '../lib/spotify-top';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = loadResumeProfile();
const spotify = loadSpotifyTopTracks();
const showMusicNav = true;

const firstJob = profile.experience[0];
const currentRole = firstJob
  ? `${firstJob.title[lang]} · ${firstJob.organization[lang]}`
  : undefined;
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.description')} mainClass="max-w-6xl">
  <div class="pb-8 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[14rem_minmax(0,1fr)]">
    <AboutPageNav lang={lang} showMusic={showMusicNav} />

    <div class="min-w-0 space-y-16 lg:space-y-20">
      <AboutHero lang={lang} intro={profile.intro} currentRole={currentRole} />
      <AboutSkills lang={lang} skills={profile.skills} />
      <AboutTimeline lang={lang} experience={profile.experience} education={profile.education} />
      <AboutHobbies lang={lang} hobbies={profile.hobbies} spotify={spotify} />
    </div>
  </div>

  <script src="../scripts/reveal-on-scroll.ts"></script>
</BaseLayout>
