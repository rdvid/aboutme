---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/ui';
import { langStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.description')}>
  <article class="mx-auto max-w-3xl">
    <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{t('about.title')}</h1>
    <p class="mt-4 text-lg text-base-content/70">{t('about.lead')}</p>

    <div class="mt-12 space-y-10">
      <section>
        <h2 class="font-display text-2xl font-semibold">{t('about.who.title')}</h2>
        <p class="mt-3 leading-relaxed text-base-content/80">{t('about.who.body')}</p>
      </section>

      <section>
        <h2 class="font-display text-2xl font-semibold">{t('about.now.title')}</h2>
        <p class="mt-3 leading-relaxed text-base-content/80">{t('about.now.body')}</p>
      </section>

      <section>
        <h2 class="font-display text-2xl font-semibold">{t('about.strengths.title')}</h2>
        <p class="mt-3 leading-relaxed text-base-content/80">{t('about.strengths.body')}</p>
      </section>

      <section>
        <h2 class="font-display text-2xl font-semibold">{t('about.hobbies.title')}</h2>
        <p class="mt-3 leading-relaxed text-base-content/80">{t('about.hobbies.body')}</p>
      </section>
    </div>
  </article>
</BaseLayout>
