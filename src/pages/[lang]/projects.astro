---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import type { Lang } from '../../i18n/ui';
import { langStaticPaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('projects.title')} description={t('projects.description')}>
  <section>
    <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{t('projects.title')}</h1>
    <p class="mt-4 max-w-2xl text-lg text-base-content/70">{t('projects.lead')}</p>
    <div class="mt-4">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
