---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getBlogPosts, postCategory, estimateReadTimeMinutes } from '../../lib/blog';
import { postSlug } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getBlogPosts('en');
  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readTimeMinutes = estimateReadTimeMinutes(post.body, post.data.readTimeMinutes);
---

<BlogPost
  lang="en"
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  category={postCategory(post)}
  heroImage={post.data.heroImage}
  readTimeMinutes={readTimeMinutes}
  draft={post.data.draft}
>
  <Content />
</BlogPost>
