---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLang } from '../i18n/ui';
import { pathFor, useTranslations } from '../i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('404.title')}>
  <section class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <p class="font-display text-6xl font-bold">404</p>
    <h1 class="mt-4 text-2xl font-semibold">{t('404.heading')}</h1>
    <p class="mt-2 text-base-content/70">{t('404.body')}</p>
    <a class="btn btn-primary mt-8" href={pathFor(lang)}>{t('404.home')}</a>
  </section>
</BaseLayout>
