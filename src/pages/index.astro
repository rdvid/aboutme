---
import { defaultLang } from '../i18n/ui';
import { pathFor } from '../i18n/utils';

const target = pathFor(defaultLang);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>Redirecting…</title>
  </head>
  <body>
    <a href={target}>Continue to {target}</a>
  </body>
</html>
