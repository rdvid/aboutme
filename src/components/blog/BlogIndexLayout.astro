---
interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<section>
  <h1 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
  <p class="mt-4 max-w-2xl text-lg text-base-content/70">{lead}</p>

  <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-[250px_minmax(0,1fr)] lg:gap-10">
    <slot name="aside" />
    <slot name="main" />
  </div>
</section>
