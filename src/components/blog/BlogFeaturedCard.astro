---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  href: string;
  category: string;
  title: string;
  description: string;
  dateLong: string;
  dateIso: string;
  readTime: string;
  heroImage?: string;
  draft?: boolean;
}

const { lang, href, category, title, description, dateLong, dateIso, readTime, heroImage, draft } =
  Astro.props;
const t = useTranslations(lang);
---

<article
  id="blog-featured"
  class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm"
>
  <div class="grid md:grid-cols-2">
    <div class="aspect-[16/10] min-h-0 overflow-hidden bg-base-200 md:aspect-auto" id="blog-featured-media">
      <img
        id="blog-featured-image"
        src={heroImage ?? ''}
        alt=""
        width={1080}
        height={720}
        class:list={['h-full w-full object-cover', !heroImage && 'hidden']}
        loading="eager"
      />
      <div
        id="blog-featured-image-fallback"
        class:list={['h-full min-h-[12rem] w-full bg-base-200', heroImage && 'hidden']}
        aria-hidden="true"
      />
    </div>
    <div class="flex min-w-0 flex-col justify-between gap-6 p-5 lg:p-7">
      <div>
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
          <span class="badge badge-secondary rounded-selector font-medium">{category}</span>
          {
            draft && import.meta.env.DEV && (
              <span class="badge badge-outline rounded-selector">{t('blog.draft')}</span>
            )
          }
          <span class="text-base-content/60">
            {t('blog.featured')} · <time datetime={dateIso}>{dateLong}</time>
          </span>
        </div>
        <h2 class="max-w-[22ch] text-balance font-display text-3xl font-medium leading-tight lg:text-[2.4rem]">
          <a class="hover:opacity-80" href={href} id="blog-featured-title">
            {title}
          </a>
        </h2>
        <p class="mt-3 max-w-[48ch] text-pretty text-sm leading-relaxed text-base-content/70" id="blog-featured-description">
          {description}
        </p>
      </div>
      <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
        <span class="truncate text-xs text-base-content/60" id="blog-featured-read-time">{readTime}</span>
        <a class="btn btn-outline rounded-selector btn-sm sm:btn-md" href={href} id="blog-featured-link">
          {t('blog.readNote')}
          <svg xmlns="https://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>
