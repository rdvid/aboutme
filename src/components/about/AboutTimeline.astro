---
import type { Lang } from '../../i18n/ui';
import { dateLocale } from '../../i18n/ui';
import type { ResumeEntry } from '../../lib/resume-profile.types';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  experience: ResumeEntry[];
  education: ResumeEntry[];
}

const { lang, experience, education } = Astro.props;
const t = useTranslations(lang);

function formatMonth(value: string): string {
  const parts = value.split('-').map(Number);
  const year = parts[0];
  const month = parts[1] ?? 1;
  if (!year) return value;
  const date = new Date(Date.UTC(year, month - 1, 1));
  return date.toLocaleDateString(dateLocale[lang], {
    year: 'numeric',
    month: parts[1] ? 'short' : undefined,
    timeZone: 'UTC',
  });
}

function formatRange(entry: ResumeEntry): string {
  const start = formatMonth(entry.start);
  const end = entry.end ? formatMonth(entry.end) : t('about.present');
  return `${start} — ${end}`;
}

const sections: { title: string; entries: ResumeEntry[] }[] = [
  { title: t('about.section.experience'), entries: experience },
  { title: t('about.section.education'), entries: education },
].filter((s) => s.entries.length > 0);
---

<section id="about-timeline" class="scroll-mt-24" data-reveal>
  <h2 class="font-display text-3xl font-semibold tracking-tight">{t('about.section.timeline')}</h2>
  {
    sections.map((section) => (
      <div class="mt-8">
        <h3 class="mb-6 font-display text-xl font-semibold">{section.title}</h3>
        <ol class="relative space-y-8 border-l-2 border-primary/25 pl-6">
          {section.entries.map((entry) => (
            <li class="relative" data-reveal>
              <span
                class="absolute -left-[1.91rem] top-1.5 size-3 rounded-full border-2 border-primary bg-base-100"
                aria-hidden="true"
              />
              <p class="text-xs font-medium uppercase tracking-wider text-primary">
                {formatRange(entry)}
              </p>
              <h4 class="mt-1 font-display text-lg font-semibold">{entry.title[lang]}</h4>
              <p class="text-sm text-base-content/75">{entry.organization[lang]}</p>
              <p class="mt-2 leading-relaxed text-base-content/90">{entry.summary[lang]}</p>
              {entry.highlights.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2">
                  {entry.highlights.map((h) => (
                    <li class="badge badge-ghost badge-sm">{h[lang]}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</section>
