---
import type { PortfolioProject } from '../lib/projects.types';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  project: PortfolioProject;
  lang: Lang;
  coverPlaceholder: string;
}

const { project, lang, coverPlaceholder } = Astro.props;
const t = useTranslations(lang);
const {
  slug,
  title,
  description,
  coverUrl,
  badges,
  repositoryUrl,
  underDevelopment,
  stars,
} = project;
---

<article
  class="card card-border bg-base-100 shadow-sm transition-shadow hover:shadow-md"
>
  <figure class="aspect-[16/10] overflow-hidden bg-base-200">
    <img
      src={coverUrl}
      alt={title}
      width="640"
      height="400"
      loading="lazy"
      class="h-full w-full object-cover"
      data-cover-placeholder={coverPlaceholder}
      onerror={`this.onerror=null;this.src='${coverPlaceholder}'`}
    />
  </figure>
  <div class="card-body gap-3 p-5">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="card-title font-display text-lg">{title}</h2>
      {
        underDevelopment ? (
          <span class="badge badge-warning badge-outline badge-sm">{t('projects.status.dev')}</span>
        ) : (
          <span class="badge badge-success badge-outline badge-sm">{t('projects.status.ready')}</span>
        )
      }
    </div>
    {
      stars > 0 && (
        <p class="text-xs text-base-content/60">
          {stars} {t('projects.stars')}
        </p>
      )
    }
    <p class="line-clamp-2 text-sm text-base-content/75">{description[lang]}</p>
    <ul class="flex flex-wrap gap-1.5">
      {
        badges.map((badge) => (
          <li class="badge badge-neutral badge-xs">{badge}</li>
        ))
      }
    </ul>
    <div class="card-actions mt-1 flex-wrap items-center justify-between gap-2">
      <button
        type="button"
        class="btn btn-primary btn-sm"
        data-project-open={slug}
      >
        {t('projects.details')}
      </button>
      <a
        class="btn btn-ghost btn-sm"
        href={repositoryUrl}
        target="_blank"
        rel="noopener"
        aria-label={t('projects.repo')}
      >
        {t('projects.repo')}
      </a>
    </div>
  </div>
</article>
