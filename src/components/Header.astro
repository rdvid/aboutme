---
import ThemeToggle from './ThemeToggle.astro';
import { languages, type Lang } from '../i18n/ui';
import { assetPath, pathFor, switchLangPath, useTranslations } from '../i18n/utils';
import { navKeys, site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang = lang === 'en' ? 'br' : 'en';
const resumeHref = assetPath(site.resume[lang]);
---

<header class="sticky top-0 z-50 border-b border-base-300/80 bg-base-100/90 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href={pathFor(lang)} class="font-display text-xl font-bold tracking-tight hover:opacity-80">
      {site.title}
    </a>

    <ul class="hidden items-center gap-6 text-sm font-medium md:flex">
      {
        navKeys.map((item) => (
          <li>
            <a class="hover:opacity-70" href={pathFor(lang, item.href)}>
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={switchLangPath(Astro.url.pathname, otherLang)}
        class="btn btn-ghost btn-sm hidden sm:inline-flex"
        hreflang={otherLang === 'br' ? 'pt-BR' : 'en'}
        aria-label={t('nav.lang')}
      >
        {otherLang === 'en' ? 'EN' : 'PT'}
      </a>
      <ThemeToggle />
      <a
        href={resumeHref}
        target="_blank"
        rel="noopener"
        class="btn btn-sm btn-ghost hidden sm:inline-flex"
      >
        {t('nav.resume')}
      </a>
      <details class="dropdown dropdown-end md:hidden">
        <summary class="btn btn-ghost btn-sm btn-square" aria-label={t('nav.menu')}>
          <svg xmlns="https://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <ul class="menu dropdown-content z-50 mt-2 w-44 rounded-box bg-base-200 p-2 shadow">
          {
            navKeys.map((item) => (
              <li>
                <a href={pathFor(lang, item.href)}>{t(item.key)}</a>
              </li>
            ))
          }
          <li>
            <a href={resumeHref} target="_blank" rel="noopener">{t('nav.resume')}</a>
          </li>
          <li>
            <a href={switchLangPath(Astro.url.pathname, otherLang)}>
              {languages[otherLang]}
            </a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>
